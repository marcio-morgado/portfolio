---
import type { ImageMetadata } from "astro";

// Page components
import { Picture } from "astro:assets";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectLink from "./ProjectLink.astro";

const allThumbs = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/thumbnails/*.{png,jpg,jpeg,webp}",
    {
        eager: true,
    },
);

// Needed for now as the Astro Picture component only supports imported or remote images. This won't be needed when CMS is connected.
---

<section class="flex flex-col gap-4 px-2 py-4">
    <SectionHeading boldText="Spotlight" />
    <!-- Slider Container so Flex doesn't mess with Swiper sizing -->
    <div>
        <div class="swiper spotlight">
            <!-- Required for swiper to function -->
            <div class="swiper-wrapper">
                <div class="swiper-slide">
                    <Picture
                        src="https://placehold.co/600x400"
                        inferSize={true}
                        alt="Placeholder"
                        class="mb-4"
                    />

                    <div class="flex flex-col gap-4">
                        <h3 class="text-2xl">Placholder Title</h3>

                        <p class="font-light">Placeholder Description</p>

                        <ProjectLink link="#" />
                    </div>
                </div>
                <div class="swiper-slide">
                    <Picture
                        src="https://placehold.co/600x400"
                        inferSize={true}
                        alt="Placeholder"
                        class="mb-4"
                    />

                    <div class="flex flex-col gap-4">
                        <h3 class="text-2xl">Placholder Title</h3>

                        <p class="font-light">Placeholder Description</p>

                        <ProjectLink link="#" />
                    </div>
                </div>
            </div>

            <div class="swiper-scrollbar"></div>
        </div>
    </div>
</section>

<script>
    import Swiper from "swiper";
    import "swiper/css";
    import "swiper/css/scrollbar";
    import { Scrollbar } from "swiper/modules";

    new Swiper(".spotlight", {
        modules: [Scrollbar],
        spaceBetween: 16,
        scrollbar: {
            el: ".swiper-scrollbar",
        },
    });
</script>

<style>
    .spotlight {
        /* Swiper looks for these variables before applying a fallback color */
        --swiper-scrollbar-bg-color: var(--color-Alabaster);
        --swiper-scrollbar-drag-bg-color: var(--color-MossGreen);
    }

    /* Pushes the scrollbar down a bit. By default it's placed over the slides. */
    .swiper-wrapper {
        margin-bottom: 24px;
    }
</style>
