---
import SectionHeading from "./SectionHeading.astro";
import ProjectVisualSingleImage from "./ProjectVisualSingleImage.astro";

import { loadImages } from "../util/loadImages";

// Data

const allImages = await loadImages(
    import.meta.glob("/src/data/projects/**/*.{jpeg,jpg,gif,png}")
);

const { sectionType, heading, text, visual } = Astro.props;
---

<!-- title with text and single visual -->{
    (sectionType === "text-and-visuals" || sectionType === "text-only") &&
        text && (
            <section class="px-2 py-8">
                <div>
                    <SectionHeading
                        boldText={heading.bold}
                        restText={heading.light}
                    />
                    <p>{text}</p>
                    <figure>
                        <figcaption>Before & After</figcaption>
                    </figure>
                </div>
            </section>
        )
}
