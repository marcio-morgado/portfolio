---
import socialLinks from "../data/socialLinks.json";

const currentYear = new Date().getFullYear();
---

<footer class="px-6 sm:px-14 py-20" data-analytics-section="footer">
    <div class="flex justify-between gap-4 items-center mb-14">
        <h2 class="text-2xl sm:text-4xl xl:text-5xl text-UtOrange font-semibold">
            <span>Let’s Collaborate</span>

            <br />
            <span class="font-light"><a href="mailto:hello@mrco.design">hello@mrco.design</a></span>
        </h2>
        <span class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"> </span>
    </div>

    <div class="flex flex-col-reverse md:flex-row md:justify-between gap-2 md:gap-0 text-sm font-light">
        <p>
            Site Content ©
            {currentYear}
            Marcio Morgado. All rights Reserved.
        </p>

        <p>Crafted with love, forged in frustration.</p>

        <ul class="inline-flex gap-8">
            {
                socialLinks.map((link) => (
                    <li>
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</footer>
