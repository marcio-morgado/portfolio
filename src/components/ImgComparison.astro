---
const { firstImgURL, secondImgURL } = Astro.props;
---

<script>
    import "img-comparison-slider";
</script>

<img-comparison-slider hover="hover">
    <figure slot="first">
        <figcaption class="font-mono absolute leading-none bottom-3 left-3">
            Before
        </figcaption>
        <img src={firstImgURL} alt="" />
    </figure>

    <figure slot="second">
        <figcaption class="font-mono absolute leading-none bottom-3 right-3">
            After
        </figcaption>
        <img src={secondImgURL} alt="" />
    </figure>
</img-comparison-slider>
