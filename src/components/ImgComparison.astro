---
const { firstImgURL, secondImgURL } = Astro.props;
---

<script>
    import "img-comparison-slider";
</script>

<img-comparison-slider hover="hover">
    <figure slot="first" class="before">
        <figcaption>Before</figcaption>
        <img src={firstImgURL} alt="" />
    </figure>

    <figure slot="second" class="after">
        <figcaption>After</figcaption>
        <img src={secondImgURL} alt="" />
    </figure>
</img-comparison-slider>

<style>
    * {
        --offset: 12px;
    }

    figcaption {
        position: absolute;
        bottom: var(--offset);
        line-height: 100%;
    }

    .before figcaption {
        left: var(--offset);
    }

    .after figcaption {
        right: var(--offset);
    }
</style>
