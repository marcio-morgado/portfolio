---
const { bold, light, as = "h2", class: extraClass = "" } = Astro.props;
const Tag = as;
---

<div class={`flex justify-between gap-4 items-center ${extraClass}`}>
    <Tag class="text-2xl text-UtOrange font-semibold">
        {bold && <span>{bold}</span>}
        {
            light && (
                <>
                    <br />
                    <span class="font-light">{light}</span>
                </>
            )
        }
    </Tag>
    <span
        class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"
    ></span>
</div>
