---
import Picture from "astro/components/Picture.astro";

import heroImage from "../assets/projects/dl-product-page/assets/dl-product-hero.avif";
---

<!-- Hero Section -->
<section class="bg-Charcoal relative h-dvh">
    <div class="relative w-full h-[120vh] overflow-hidden">
        <div class="w-full h-full">
            <Picture
                src={heroImage}
                alt={""}
                class="heroImg absolute inset-0 object-cover align-middle h-full"
            />
        </div>
    </div>
    <!-- Project Card Wrapper -->
    <div
        class="flex flex-col justify-end fixed w-screen max-w-full h-full items-end inset-0 z-10 p-2"
    >
        <!-- Inner wrapper -->
        <div>
            <div>tab</div>
            <!-- Project Card - Inner Wrapper-->
            <div
                class="projectCard flex flex-col gap-8 justify-between p-6 bg-Alabaster rounded-lg text-sm md:max-w-[450px]"
            >
                <div class="flex flex-col gap-4">
                    <div
                        class="text-lg leading-6 flex justify-between gap-4 items-center"
                    >
                        <h1 class="font-semibold">
                            <span>Data Link</span>

                            <br />
                            <span class="font-light">Product Page Redesign</span
                            >
                        </h1>
                        <span
                            class="h-0.25 bg-current w-full flex-[1] self-end translate-y-[-0.5em]"
                        ></span>
                    </div>

                    <p>
                        I redesigned the Nasdaq Data Link product page to
                        simplify complex financial dataset offerings. By
                        introducing a single-page layout with a dynamic pricing
                        component and clearer product details, we improved user
                        trust, boosted self-serve checkouts, and reduced support
                        requests.
                    </p>

                    <ul class="text-xs">
                        <li>Project type: Marketing & Product UX</li>
                        <li>Role: Product Designer</li>
                        <li>Platform: Nasdaq Data Link</li>
                        <li>
                            Focus: Lorem ipsum dolor sit amet consectetur,
                            adipisici
                        </li>
                    </ul>
                </div>

                <div
                    class="w-full pt-4 flex gap-4 border-t border-Charcoal projectNav"
                >
                    <a class="fill-Silver hover:fill-UtOrange" href="#"
                        ><svg
                            width="4em"
                            viewBox="0 0 53 14"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M6.96613 14L0.123156 7.15702L6.96613 0.314048L7.86733 1.19997L2.5518 6.51549H52.9882V7.79855H2.5518L7.86733 13.0988L6.96613 14Z"
                            ></path>
                        </svg>
                    </a>

                    <a class="fill-current hover:fill-UtOrange" href="#"
                        ><svg
                            width="4em"
                            viewBox="0 0 54 14"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M46.7105 14L45.8094 13.0988L51.1249 7.79853H0.688477V6.51547H51.1249L45.8094 1.19995L46.7105 0.314026L53.5535 7.157L46.7105 14Z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
