<section id="intro" aria-label="Hero" class="flex flex-col px-2 py-8 gap-16">
    <h2 class="text-sm w-[268px] self-end">
        A product and visual designer with over a decade of experience
        simplifying complex workflows, creating accessible, scalable products,
        and solving design challenges through collaboration — always with a
        steady supply of coffee.
    </h2>

    <!-- Title & Subtitle -->
    <div class="flex gap-4 justify-between">
        <div class="w-full">
            <p class="text-2xl text-Charcoal uppercase font-bold">Hey folks,</p>

            <div
                class="text-7xl font-extralight text-UtOrange inline-flex w-full gap-4 justify-between"
            >
                <h1 class="group relative">
                    I’m <span class="inline-block relative ml-2">
                        <span
                            class="block group-hover:opacity-20 group-hover:text-[#FFD3A5] transition-opacity duration-300"
                            >Marcio</span
                        >
                        <span
                            class="block absolute left-0 top-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-y-1/2 text-center w-full text-[0.4em]"
