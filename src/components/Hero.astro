                <!-- Scroll Arrow -->
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-[0.25em] fill-Silver"
                    viewBox="0 0 21 79"
                    ><path
                        d="m0 68.477 1.75-1.75 7.181 7.205V0h2.5v73.932l7.205-7.205 1.727 1.75L10.182 78.66 0 68.477Z"
