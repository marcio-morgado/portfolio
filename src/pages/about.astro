---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const projectFetch = await getEntry("projects", "dl-product-page/index");

const project = projectFetch?.data;
---

<section>
    <h1>{project?.title}</h1>
    <Image src={project?.hero.cover} alt={project?.thumb.alt} />
</section>
