        <main>
            <!-- Hero section -->
            <section
                id="hero"
                aria-label="Hero"
                class="relative w-screen h-fit md:h-screen flex flex-col py-10 px-6 lg:py-[60px] lg:px-14 justify-center text-2xl md:text-3xl lg:text-4xl xl:text-[56px] xl:leading-normal before:content-[''] before:absolute before:-z-10 before:inset-0 before:opacity-[0.4] before:bg-[url('/about_me.svg')] before:bg-origin-border before:bg-contain before:bg-repeat-y">
                <h1 class="text-UtOrange font-semibold">Meet the designer</h1>
