---
import Tracker from "../components/Tracker.astro";
import socialLinks from "../data/socialLinks.json";

import "../styles/global.css";
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Marcio Morgado • About Me</title>
        <Tracker />
    </head>
    <body>
        <!-- Header -->
        <header
            id="banner"
            role="banner"
            class="h-[60px] w-full py-4 px-6 backdrop-blur-xs z-10 flex justify-between sticky top-0">
            <div class="w-fit flex gap-8 items-center">
                <!-- Logo -->
                <div class="fill-Charcoal hover:fill-Ochre">
                    <a href="/">
                        <svg xmlns="http://www.w3.org/2000/svg" width="51" height="14" viewBox="0 0 51 14">
                            <path
                                d="M50.163 6.977c0 1.296-.252 2.389-.755 3.279-.504.886-1.184 1.558-2.04 2.017-.856.454-1.81.681-2.864.681-1.06 0-2.019-.229-2.875-.687-.852-.462-1.53-1.136-2.034-2.023-.5-.89-.75-1.979-.75-3.267 0-1.295.25-2.386.75-3.272.504-.89 1.182-1.563 2.034-2.018C42.485 1.23 43.444 1 44.504 1c1.053 0 2.008.23 2.864.688.856.454 1.536 1.126 2.04 2.017.503.886.755 1.977.755 3.272Zm-3.25 0c0-.697-.092-1.284-.278-1.761-.182-.481-.453-.845-.813-1.091-.356-.25-.795-.375-1.318-.375-.522 0-.964.125-1.324.375-.356.246-.627.61-.812 1.09-.182.478-.273 1.065-.273 1.762 0 .697.091 1.286.273 1.767.185.478.456.841.812 1.091.36.246.802.37 1.324.37.523 0 .962-.124 1.319-.37.36-.25.63-.613.812-1.09.186-.482.278-1.07.278-1.768Z"
                            ></path><path
                                d="M37.457 5.523h-3.204a2.172 2.172 0 0 0-.182-.722 1.629 1.629 0 0 0-.398-.557c-.166-.159-.369-.28-.608-.363a2.36 2.36 0 0 0-.812-.131c-.53 0-.98.129-1.347.386-.363.258-.64.627-.83 1.108-.185.481-.278 1.059-.278 1.733 0 .712.095 1.309.284 1.79.194.477.472.837.836 1.08.363.238.8.357 1.312.357.292 0 .553-.035.784-.107a1.84 1.84 0 0 0 .602-.324c.171-.14.31-.309.415-.506.11-.2.184-.426.222-.676l3.204.023a4.342 4.342 0 0 1-.414 1.505 4.897 4.897 0 0 1-1.017 1.41c-.436.427-.976.772-1.62 1.034-.644.26-1.392.391-2.244.391-1.068 0-2.026-.229-2.875-.687-.845-.458-1.513-1.133-2.006-2.023-.488-.89-.733-1.979-.733-3.267 0-1.295.25-2.386.75-3.272.5-.89 1.175-1.563 2.023-2.018C30.17 1.23 31.116 1 32.162 1c.735 0 1.411.1 2.028.301.618.2 1.16.494 1.625.88.466.383.841.855 1.125 1.416.285.56.457 1.202.517 1.926Z"
                            ></path><path
                                d="M15.906 12.796V1.159h5.023c.864 0 1.62.157 2.267.472a3.532 3.532 0 0 1 1.511 1.358c.36.59.54 1.299.54 2.125 0 .833-.185 1.536-.557 2.108-.367.572-.884 1.003-1.55 1.295-.664.292-1.438.438-2.325.438h-3V6.5h2.364c.371 0 .688-.045.949-.136a1.2 1.2 0 0 0 .608-.45c.144-.204.216-.47.216-.8 0-.334-.072-.604-.216-.813a1.207 1.207 0 0 0-.608-.466c-.262-.102-.578-.153-.949-.153h-1.114v9.114h-3.159Zm6.818-5.341 2.91 5.34h-3.432l-2.841-5.34h3.363Z"
                            ></path><path
                                d="M1 1.16h3.932l2.704 6.59h.137l2.704-6.59h3.932v11.636h-3.09V6.068h-.092l-2.59 6.637H6.772L4.182 6.023H4.09v6.773H1V1.159Z"
                            ></path>
                        </svg>
                    </a>
                </div>

                <!-- Menu button -->
                <button type="button" id="openNavBtn" aria-label="Open menu" class="w-fit flex gap-2 cursor-pointer">
                    <div class="w-[24px] flex flex-col gap-2 items-center justify-center">
                        <span class="h-[2px] w-full bg-Charcoal block"></span>
                        <span class="h-[2px] w-full bg-Charcoal block"></span>
                    </div>
                    menu
                </button>
            </div>

            <div id="info" class="flex gap-6 text-[12px]">
                <div>
                    <p>Marcio Morgado</p>
                    <p>Product Designer</p>
                </div>

                <div>
                    <p>Toronto / Remote</p>
                    <p>Available for work</p>
                </div>
            </div>
        </header>
        <nav
            id="mainNav"
            aria-label="Main navigation"
            class="h-full w-full sm:w-1/2 lg:w-1/3 p-10 fixed inset-0 z-10 flex flex-col justify-between -translate-x-full bg-Alabaster">
            <!-- Close Navigation Button -->
            <button
                id="closeNavBtn"
                type="button"
                aria-label="Close menu"
                aria-expanded="false"
                class="font-thin text-6xl text-left hover:text-MossGreen cursor-pointer w-fit hover:font-light transition-all duration-150"
                >X</button
            >

            <!-- Navigation Link -->
            <div class="menu-items">
                <ul class="flex flex-col gap-8 text-2xl font-light group">
                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="/projects"
                            class="flex border-b-2 py-2 justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                            Projects <svg class="fill-current w-8 h-8" aria-hidden="true"
                                ><use href="arrows.svg#rtArrow"></use></svg
                            >
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="/about"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                            About
                            <svg class="fill-current w-[1.25em] h-[1.25em]" aria-hidden="true"
                                ><use href="arrows.svg#rtArrow"></use>
                            </svg>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="#"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                            Résumé <span class="text-base">[PDF: 128kb]</span>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="https://calendly.com/marcio-morgado/30min"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                            Book a Discovery Call
                            <svg class="fill-current w-[1.15em] h-[1.15em]"
                                ><use href="arrows.svg#diagArrow"></use>
                            </svg>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="mailto:hello@mrco.design"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                            Let's Collaborate
                            <span class="text-base">[email]</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Social Links -->
            <div class="social-items flex justify-between items-end">
                <ul class="group">
                    {
                        socialLinks.map((link) => (
                            <li class="group/item navItem">
                                <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300">
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <p>© {currentYear}</p>
            </div>
        </nav>

        <main>
            <!-- Hero section -->
            <section
                id="hero"
                aria-label="Hero"
                class="relative w-screen h-screen flex flex-col before:content-[''] before:absolute before:-z-10 before:inset-0 before:opacity-[0.6] before:bg-[url('/about_me.svg')] before:bg-origin-border before:bg-contain before:bg-no-repeat py-[60px] px-14 justify-center">
                <h1>About Me</h1>
                <p class="w-[40ch] text-[40px] text-Charcoal">
                    I’m a designer who’s done it all — from shaping visual identities to solving complex product
                    challenges. Thirteen years, three roles, one goal: create experiences people enjoy using.
                </p>
            </section>

            <section
                ata-analytics-section="introduction"
                class="text-Charcoal grid grid-cols-6 py-[60px] px-14 relative">
                <div class="col-span-2"><h2 class="text-3xl">Introduction</h2></div>

                <div class="w-[65ch] col-auto">
                    <p class="mb-4">
                        I’m a Toronto-based Senior Product Designer who loves turning complex problems into experiences
                        that feel effortless. My journey started with animation and a fascination for computers and art.
                        In high school, a single design class opened my eyes to the idea of making things people
                        actually use — whether that’s a logo, a printed report, or later, a digital product.
                    </p>
                    <p>
                        I thrive on solving complex problems and making them simple for users. Whether it’s designing
                        data-heavy dashboards, streamlining workflows, or crafting layouts that are easy to digest, my
                        work blends clarity, craft and strategy. Some of my favorite projects: designing a spring stamp
                        for Canada Post — a tiny canvas that traveled across the country — and building the Nasdaq Data
                        Link product page, where I translated a mountain of financial data into something usable for a
                        wide range of users.
                    </p>
                </div>
            </section>

            <section ata-analytics-section="what-i-do" class="text-Charcoal grid grid-cols-6 py-[60px] px-14">
                <div class="col-span-2"><h2 class="text-3xl">What I do</h2></div>

                <div class="w-[65ch] col-auto">
                    <p class="mb-4">
                        I thrive on solving complex problems and making them simple for users. Whether it’s designing
                        data-heavy dashboards, streamlining workflows, or crafting layouts that are easy to digest, my
                        work blends clarity, craft and strategy.
                    </p>
                    <p>
                        Some of my favorite projects: designing a spring stamp for Canada Post — a tiny canvas that
                        traveled across the country — and building the Nasdaq Data Link product page, where I translated
                        a mountain of financial data into something usable for a wide range of users.
                    </p>
                </div>
            </section>

            <section ata-analytics-section="my-process" class="text-Charcoal grid grid-cols-6 py-[60px] px-14">
                <div class="col-span-2"><h2 class="text-3xl">My Process</h2></div>

                <div class="w-[65ch] col-auto">
                    <p class="mb-4">
                        I like to think of design as bringing order to chaos. When a problem feels messy or
                        overwhelming, I break it into small questions and tackle them one at a time. I start with
                        research and rough sketches, collaborate early with engineers to avoid pitfalls and iterate
                        until the solution is both usable and implementable.
                    </p>
                    <p>
                        My design mantra: great design is invisible. If users complete their tasks without thinking
                        about the interface, I’ve done my job.
                    </p>
                </div>
            </section>

            <section ata-analytics-section="final-thoughts" class="text-Charcoal grid grid-cols-6 py-[60px] px-14">
                <div class="col-span-2"><h2 class="text-3xl">Final Thoughts</h2></div>

                <div class="w-[65ch] col-auto">
                    <p class="mb-4">
                        Product design is constantly evolving and that’s what excites me most. Tools like AI are already
                        speeding up prototyping and helping explore ideas faster. I’m looking for teams that value
                        collaboration, encourage experimentation and tackle meaningful problems — the kind where
                        thoughtful design can really make a difference.
                    </p>
                    <p>
                        My design mantra: great design is invisible. If users complete their tasks without thinking
                        about the interface, I’ve done my job.
                    </p>
                </div>
            </section>
        </main>

        <!-- Footer -->
        <footer class="px-6 sm:px-14 py-20">
            <div class="flex justify-between gap-4 items-center mb-14">
                <h2 class="text-2xl text-UtOrange font-semibold">
                    <span>Let’s Collaborate</span>

                    <br />
                    <span class="font-light"><a href="mailto:hello@mrco.design">hello@mrco.design</a></span>
                </h2>
                <span class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"></span>
            </div>

            <div class="flex flex-col-reverse md:flex-row md:justify-between gap-2 md:gap-0">
                <p class="uppercase font-extralight text-base">
                    Site Content © {currentYear} Marcio Morgado <br />All rights Reserved
                </p>
                <p>Crafted with love, forged in frustration.</p>
                <ul class="inline-flex gap-8">
                    {
                        socialLinks.map((link) => (
                            <li>
                                <a href={link.url} target="_blank" rel="noopener noreferrer">
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </footer>

        <script>
            //@ts-nocheck
            import gsap from "gsap";

            const nav = document.getElementById("mainNav");
            const navItems = document.querySelectorAll(".navItem");
            const openBtn = document.getElementById("openNavBtn");
            const closeBtn = document.getElementById("closeNavBtn");

            // Create Navigation Animation Timeline
            const navTl = gsap.timeline({ paused: true, reversed: true });

            navTl
                .to(nav, {
                    x: 0,
                    duration: 0.6,
                    ease: "power3.inOut",
                    onStart: nav?.setAttribute("aria-expanded", "true"),
                })
                .from(
                    navItems,
                    {
                        opacity: 0,
                        duration: 0.5,
                        ease: "power1.inOut",
                        stagger: 0.1,
                    },
                    "-=0.2"
                );

            let isOpen = false;

            function openNav() {
                navTl.play();

                isOpen = true;
            }

            function closeNav() {
                navTl.reverse();

                isOpen = false;
            }

            openBtn?.addEventListener("click", openNav);
            closeBtn?.addEventListener("click", closeNav);

            document.addEventListener("click", (e) => {
                if (isOpen && !nav?.contains(e.target) && !openBtn?.contains(e.target)) closeNav();
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && isOpen) closeNav();
            });
        </script>
    </body>
</html>
