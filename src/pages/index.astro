                            ></path>
                        </svg>
                    </a>
                </div>
                <button
                    type="button"
                    id="openNavBtn"
                    aria-label="Open menu"
                    class="w-fit flex gap-2 cursor-pointer"
                >
                    <div
                        class="w-[24px] flex flex-col gap-2 items-center justify-center"
                    >
                        <span class="h-[2px] w-full bg-Charcoal block"></span>
                        <span class="h-[2px] w-full bg-Charcoal block"></span>
                    </div>
                    menu
                </button>
            </div>

            <div id="info" class="flex gap-6 text-[12px]">
                <div>
                    <p>Marcio Morgado</p>
                    <p>Product Designer</p>
                </div>

                <div>
                    <p>Toronto / Remote</p>
                    <p>Available for work</p>
                </div>
            </div>
        </header>
        <nav
            id="mainNav"
            aria-label="Main navigation"
            class="h-full w-full sm:w-1/2 lg:w-1/3 p-10 fixed inset-0 z-10 flex flex-col justify-between -translate-x-full bg-Alabaster"
        >
            <!-- Close Navigation Button -->
            <button
                id="closeNavBtn"
                type="button"
                aria-label="Close menu"
                aria-expanded="false"
                class="font-thin text-6xl text-left hover:text-MossGreen cursor-pointer w-fit hover:font-light transition-all duration-150"
                >X</button
            >

            <!-- Navigation Link -->
            <div class="menu-items">
                <ul class="flex flex-col gap-8 text-2xl font-light group">
                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="/projects"
                            class="flex border-b-2 py-2 justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                        >
                            Projects <svg
                                class="fill-current w-8 h-8"
                                aria-hidden="true"
                                ><use href="arrows.svg#rtArrow"></use></svg
                            >
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="/about"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                        >
                            About
                            <svg
                                class="fill-current w-[1.25em] h-[1.25em]"
                                aria-hidden="true"
                                ><use href="arrows.svg#rtArrow"></use>
                            </svg>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="#"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                        >
                            Résumé <span class="text-base">[PDF: 128kb]</span>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="https://calendly.com/marcio-morgado/30min"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                        >
                            Book a Discovery Call
                            <svg class="fill-current w-[1.15em] h-[1.15em]"
                                ><use href="arrows.svg#diagArrow"></use>
                            </svg>
                        </a>
                    </li>

                    <!-- Navigation Link -->
                    <li class="group/item navItem">
                        <a
                            href="mailto:hello@mrco.design"
                            class="border-b-2 py-2 flex justify-between w-full group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                        >
                            Let's Collaborate
                            <span class="text-base">[email]</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Social Links -->
            <div class="social-items flex justify-between items-end">
                <ul class="group">
                    {
                        socialLinks.map((link) => (
                            <li class="group/item navItem">
                                <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="group-hover:text-Silver group-hover/item:text-Gummetal transition-colors duration-300"
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <p>© {currentYear}</p>
            </div>
        </nav>

        <!-- Page Content -->
        <main>
            <!-- Hero Section -->
            <section
                id="hero"
                aria-label="Hero"
                class="relative w-screen h-screen flex flex-col before:content-[''] before:absolute before:inset-0 before:opacity-[0.4] before:bg-[url('/mrco.svg')] before:bg-origin-border before:bg-contain py-[60px] justify-center"
            >
                <div class="relative px-6 sm:px-14 flex flex-col gap-6">
                    <h1
                        class="text-[3.5rem] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.563rem] leading-tight font-extrabold"
                    >
                        Hey folks,<br />
                        <span class="text-UtOrange">I’m Marcio.</span>
                    </h1>

                    <div
                        class="flex flex-col gap-[100px] sm:flex-row sm:justify-between"
                    >
                        <p class="sm:max-w-1/2 lg:max-w-[50ch]">
                            I’m a designer who’s done it all — from shaping
                            visual identities to solving complex product
                            challenges. Thirteen years, three roles, one goal:
                            create experiences people enjoy using.
                        </p>

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="fill-Charcoal w-24"
                            viewBox="0 0 108 120"
