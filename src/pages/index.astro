                            ></path>
                        </svg>
                    </div>
                </div>
            </section>

            <!-- Spotlight Section -->
            <section class="py-20 px-6 sm:px-14 w-full h-screen">
                <!-- Slideshow Wrapper Desktop-->
                <div class="lg:flex h-full w-full gap-6 hidden">
                    <!-- Left Side -->
                    <div class="flex-1 w-[1px] flex flex-col gap-10">
                        <!-- Heading -->
                        <div class="flex justify-between gap-4 items-center">
                            <h2
                                class="text-2xl md:text-5xl text-UtOrange font-semibold"
                            >
                                Spotlight
                            </h2>
                            <span
                                class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"
                            ></span>
                        </div>

                        <!-- Slider Content Wrapper -->

                        <div class="flex flex-col justify-between h-full">
                            <!-- Slider Content -->
                            <div class="slider-content flex flex-col gap-8">
                                <h3
                                    data-spotlightSlide="heading"
                                    class="text-4xl"
                                >
                                </h3>
                                <p
                                    data-spotlightSlide="copy"
                                    class="max-w-[50ch]"
                                >
                                </p>

                                <a
                                    data-spotlightSlide="link"
                                    href="#"
                                    class="proj-btn py-1 px-2 flex gap-1 w-fit"
                                >
                                    <p class="flex-1 uppercase">
                                        Explore project
                                    </p>
                                    <svg
                                        class="fill-Charcoal w-4"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 12 11"
                                    >
                                        <path
                                            d="M.636 6.228a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm1.08 4.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm0-9a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.984 7.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm-.048-3a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.048-3a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.984 4.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .385-.156c.151 0 .28.052.383.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.155.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.385-.156Zm0-3a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .385-.156c.151 0 .28.052.383.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.155.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.385-.156Zm.985 1.5a.522.522 0 0 1-.157-.384c0-.152.053-.28.156-.384a.522.522 0 0 1 .385-.156c.151 0 .28.052.383.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.155.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.385-.156Z"
                                        ></path>
                                    </svg>
                                </a>
                            </div>

                            <!-- Slider Nav -->
                            <ul
                                data-spotlightSlide="listContainer"
                                class="flex flex-col gap-2"
                            >
                                <!-- List item -->
                            </ul>
                        </div>
                    </div>
                    <!-- Right Side -->
                    <div
                        class="relative flex-1 w-[1px] bg-LightOrange rounded-2xl overflow-hidden"
                    >
                        <img
                            src=""
                            alt=""
                            data-spotlightSlide="thumb"
                            class="w-full h-full object-cover absolute inset-0"
                        />
                    </div>
                </div>

                <!-- Slider Wrapper Mobile -->
                <div class="w-full h-full flex flex-col gap-4 lg:hidden">
                    <!-- Section Heading -->
                    <div class="flex justify-between gap-4 items-center">
                        <h2
                            class="text-2xl md:text-5xl text-UtOrange font-semibold"
                        >
                            Spotlight
                        </h2>
                        <span
                            class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"
                        ></span>
                    </div>
                    <!-- Swiper Slider -->
                    <div class="w-full h-full">
                        <div class="swiper spotLightMb">
                            <div class="swiper-wrapper spotLightMbWrapper">
                                {
                                    featureProjects.map((project) => (
                                        <div class="swiper-slide relative spotLightMbSlide">
                                            <img
                                                src={project.thumb.src}
                                                alt=""
                                                data-spotlightSlide="thumb"
                                                class="w-full h-full mb-4"
                                            />
                                            <div class="flex flex-col gap-4">
                                                <h3 class="text-2xl">
                                                    {project.shortTitle}
                                                </h3>

                                                <p class="font-light">
                                                    {project.shortDesc}
                                                </p>
                                            </div>
                                        </div>
                                    ))
                                }
                            </div>

                            <div class="swiper-scrollbar spotLightScrollBar">
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Footer -->
        <Footer />

        <script
            id="feature-projects-data"
            type="application/json"
            set:html={JSON.stringify(featureProjects)}
        />

        <script>
            //@ts-nocheck
            import gsap from "gsap";
            import Swiper from "swiper";
            import { Scrollbar } from "swiper/modules";
            import "swiper/css";
            import "swiper/css/scrollbar";

            // Initialize Spotlight Desktop version
            function initSpotLightDesktop() {
                const featureProjects = JSON.parse(
                    document.getElementById("feature-projects-data")
                        ?.textContent
                );

                const spotTitle = document.querySelector(
                    '[data-spotlightSlide="heading"]'
                );

                const spotCopy = document.querySelector(
                    '[data-spotlightSlide="copy"]'
                );

                const spotLink = document.querySelector(
                    '[data-spotlightSlide="link"]'
                );

                const spotThumb = document.querySelector(
                    '[data-spotlightSlide="thumb"]'
                );

                const spotListContainer = document.querySelector(
                    '[data-spotlightSlide="listContainer"]'
                );

                let currentIndex = 0;

                // Update Spotlight Section content
                function updateSpotlightSection(index) {
                    const item = featureProjects[index];

                    spotTitle.textContent = item.shortTitle;
                    spotCopy.textContent = item.shortDesc;
                    spotThumb.src = item.thumb.src;
                    spotLink.href = item.slug;

                    // Add class list to current item
                    listItems[index].classList.add("active");

                    gsap.to(listItems[index].querySelector(".inner-line"), {
                        scaleX: 1,
                        duration: 0.6,
                        ease: "power2.out",
                    });
                }

                // Render Spotlight Nav Items
                spotListContainer.innerHTML = featureProjects
                    .map(
                        ({ shortTitle }) => `
                <li  class="flex flex-col gap-2 py-2 group"
                                    data-spotlightSlide="listItem"
                                >
                                    <button
                                        type="button"
                                        class="w-full flex justify-between text-Silver group-[.active]:text-ResedaGreen font-mono"
                                    >
                                        <h4>${shortTitle}</h4>

                                        <svg
                                            class="w-5 h-5 fill-Silver group-[.active]:fill-ResedaGreen"
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 20 20"
                                        >
                                            <path
                                                d="M10.627 8.757h8.757v1.886h-8.757v8.756h-1.87v-8.756H0V8.757h8.757V0h1.87v8.757Z"
                                            ></path>
                                        </svg>
                                    </button>

                                   
                                    
                                    <div class="w-full h-1 bg-Silver/30 scale-y-[0.5] origin-bottom overflow-hidden">
                                        <div
                                            class="inner-line h-full bg-ResedaGreen scale-x-0 origin-left "
                                        ></div>
                                    </div>
                                </li>

            `
                    )
                    .join("");

                // Select all Spotlight Nav items
                const listItems = document.querySelectorAll(
                    '[ data-spotlightSlide="listItem"]'
                );

                // Add click event to each Spotlight Nav Item
                listItems.forEach((item, index) => {
                    const line = item.querySelector(".inner-line");

                    item.addEventListener("click", () => {
                        // remove active class from all
                        listItems.forEach((el) => {
                            el.classList.remove("active");

                            gsap.to(el.querySelector(".inner-line"), {
                                scaleX: 0,
                                duration: 0.4,
                                ease: "power2.inOut",
                            });
                        });

                        // add active class to clicked item
                        item.classList.add("active");

                        // Animate line fill
                        gsap.to(line, {
                            scaleX: 1,
                            duration: 0.6,
                            ease: "power2.out",
                        });

                        // Update section content
                        updateSpotlightSection(index);
                    });
                });

                // Init Spotlight Section
                updateSpotlightSection(currentIndex);
            }
            // Initialize Spotlight Mobile Version
            function initSpotLightMobile() {
                new Swiper(".spotLightMb", {
                    spaceBetween: 16,
                    modules: [Scrollbar],
                    scrollbar: { el: ".spotLightScrollBar" },
                });
            }
            // Handle window resize event and call desktop/mobile function
            function handleResize() {
                if (window.innerWidth >= 1025) {
                    initSpotLightDesktop();
                } else {
                    initSpotLightMobile();
                }
            }

            window.addEventListener("resize", handleResize);

            handleResize();
        </script>

        <style>
            .spotLightMb {
                --swiper-scrollbar-bg-color: var(--color-Alabaster);
                --swiper-scrollbar-drag-bg-color: var(--color-MossGreen);
            }
            .swiper-wrapper {
                margin-bottom: 24px;
            }
        </style>
    </body>
</html>
