---
import DesignArchive from "../components/DesignArchive.astro";
import Spotlight from "../components/Spotlight.astro";
import Tracker from "../components/Tracker.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import Picture from "astro/components/Picture.astro";

import { getCollection } from "astro:content";

// const projects = await getCollection("projects");

// const featuredProject = projects.filter(
//     (project) => project.data.isFeatured === true
// );

// Test Images, delete after
import dlProductThumb from "../content/projects/dl-product-page/assets/dl-product-thumb.jpg";

import dlManagerThumb from "../data/dl-manager-thumb.jpg";

import dlPlatformThumb from "../data/dl-platform-thumb.jpg";

import dAlpThumb from "../data/digital-assets-landing-page-thumb.jpg";

// Test content, delete after
const featureProjects = [
    {
        shortTitle: "Redesigning the Data Link Product Page",
        shortDesc:
            "Redesigning Nasdaq’s product pages to improve clarity, accessibility, and conversion for financial data products.",
        slug: "/projects/dl-product-page",
        thumb: dlProductThumb,
    },
    {
        shortTitle: "Reimagining the Data Link Platform Experience",
        shortDesc:
            "Overhauled the platform’s UI/UX to deliver a cohesive, intuitive experience for exploring financial datasets.",
        slug: "/projects/dl-ui-ux",
        thumb: dlPlatformThumb,
    },
    {
        shortTitle: "Designing the Data Link Manager",
        shortDesc:
            "Built a tool to simplify dataset and subscription management with a focus on usability and transparency.",
        slug: "/projects/dl-manager",
        thumb: dlManagerThumb,
    },
    {
        shortTitle: "Designing the Digital Assets Landing Page",
        shortDesc:
            "Created a conversion-focused landing page to showcase digital asset products and drive user engagement.",
        slug: "/projects/digital-assets-lp",
        thumb: dAlpThumb,
    },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon/favicon-16x16.png"
        />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Marcio Morgado • Product Designer</title>
        <Tracker />
    </head>
    <body class="bg-FloralWhite text-Charcoal">
        <!-- Header -->
        <header
            id="banner"
            role="banner"
            class="h-[60px] w-full py-4 px-6 backdrop-blur-xs z-10 flex justify-between sticky top-0"
        >
            <div
                id="menu-btn"
                class="w-[24px] flex flex-col gap-2 items-center justify-center"
            >
                <span class="h-[2px] w-full bg-Charcoal block"></span>
                <span class="h-[2px] w-full bg-Charcoal block"></span>
            </div>
            <div id="info" class="flex gap-6 text-[12px]">
                <div>
                    <p>Marcio Morgado</p>
                    <p>Product Designer</p>
                </div>

                <div>
                    <p>Toronto / Remote</p>
                    <p>Available for work</p>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main>
            <!-- Hero Section -->
            <section
                id="hero"
                aria-label="Hero"
                class="relative w-screen h-screen flex flex-col before:content-[''] before:absolute before:inset-0 before:opacity-[0.4] before:bg-[url('/mrco.svg')] before:bg-origin-border before:bg-contain py-[60px] justify-center"
            >
                <div class="relative px-6 sm:px-14 flex flex-col gap-6">
                    <h1
                        class="text-[3.5rem] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.563rem] leading-tight font-extrabold"
                    >
                        Hey folks,<br />
                        <span class="text-UtOrange">I’m Marcio.</span>
                    </h1>

                    <div
                        class="flex flex-col gap-[100px] sm:flex-row sm:justify-between"
                    >
                        <p class="sm:max-w-1/2 lg:max-w-[50ch]">
                            I’m a designer who’s done it all — from shaping
                            visual identities to solving complex product
                            challenges. Thirteen years, three roles, one goal:
                            create experiences people enjoy using.
                        </p>

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="fill-Charcoal w-24"
                            viewBox="0 0 108 120"
                            ><path
