                                        ></path>
                                    </svg>
                                </a>
                            </div>

                            <!-- Slider Nav -->
                            <div class="slider-nav flex flex-col gap-2">
                                <!-- List Item -->
                                <div class="flex flex-col gap-2 py-2">
                                    <!-- Project Title -->
                                    <div class="flex font-mono font-medium">
                                        <h4 class="flex-1">
                                            Data Link Product Page Redesign
                                        </h4>
                                        <div class="w-4">
                                            <svg
                                                class="fill-MossGreen w-full"
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 20 20"
                                                ><path
                                                    d="M10.627 8.757h8.757v1.886h-8.757v8.756h-1.87v-8.756H0V8.757h8.757V0h1.87v8.757Z"
                                                ></path></svg
                                            >

                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="21"
                                                height="3"
                                                fill="none"
                                                viewBox="0 0 21 3"
                                                ><path
                                                    fill="#DDD9CF"
                                                    d="M.794 2.643V.757h19.384v1.886H.794Z"
                                                ></path></svg
                                            >
                                        </div>
                                    </div>

                                    <!-- Line -->
                                    <div class="w-full bg-SlateGray h-0.5">
                                        <div class="itemLine w-[0px] h-0.5">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Right Side -->
                    <div class="flex-1 w-[1px] bg-LightOrange rounded-2xl">
                    </div>
                </div>

                <!-- Slider Wrapper Mobile -->
            </section>
            <Spotlight />
            <!-- <DesignArchive /> -->
        </main>

        <!-- Footer -->
        <Footer />

        <style>
            @keyframes expandWidth {
                0% {
                    width: 0;
                }
                100% {
                    width: 100%;
                }
            }

            .itemLine {
                background-image: radial-gradient(
                    circle at center,
                    #333 2px,
                    transparent 2px
                ); /* Dark gray dot, 2px size */
            }

            .active.itemLine {
                animation: expandWidth 2s forwards;
            }
        </style>
    </body>
</html>
