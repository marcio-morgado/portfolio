7 0 2.719.519 3.755 1.557 1.122 1.124 1.683 2.421 1.683 3.892 0 1.47-.56 2.724-1.683 3.762-1.036 1.124-2.288 1.686-3.755 1.686-1.468 0-2.763-.562-3.885-1.686-1.036-1.038-1.554-2.292-1.554-3.762 0-1.47.518-2.768 1.554-3.892Zm0 87.178c1.122-1.038 2.417-1.557 3.885-1.557 1.467 0 2.719.52 3.755 1.557 1.122 1.124 1.683 2.422 1.683 3.892 0 1.557-.56 2.854-1.683 3.892-1.036 1.038-2.288 1.557-3.755 1.557-1.468 0-2.763-.52-3.885-1.557-1.036-1.038-1.554-2.335-1.554-3.892 0-1.47.518-2.767 1.554-3.892ZM18 89.384c1.036-1.038 2.288-1.557 3.755-1.557 1.468 0 2.72.519 3.756 1.557 1.122 1.124 1.683 2.421 1.683 3.892 0 1.556-.56 2.854-1.683 3.892-1.036 1.037-2.288 1.556-3.756 1.556-1.467 0-2.719-.519-3.755-1.556-1.122-1.038-1.683-2.336-1.683-3.892 0-1.47.56-2.768 1.683-3.892Zm64.619 0c1.122-1.038 2.417-1.557 3.885-1.557 1.467 0 2.719.519 3.755 1.557 1.122 1.124 1.683 2.421 1.683 3.892 0 1.556-.56 2.854-1.683 3.892-1.036 1.037-2.288 1.556-3.755 1.556-1.468 0-2.763-.519-3.885-1.556-1.036-1.038-1.554-2.336-1.554-3.892 0-1.47.518-2.768 1.554-3.892Zm16.057-10.768c1.123-1.038 2.418-1.556 3.885-1.556 1.468 0 2.72.518 3.756 1.556 1.122 1.124 1.683 2.422 1.683 3.892 0 1.557-.561 2.854-1.683 3.892-1.036 1.038-2.288 1.557-3.756 1.557-1.467 0-2.762-.52-3.885-1.557-1.036-1.038-1.554-2.335-1.554-3.892 0-1.47.518-2.767 1.554-3.892Z"
                            ></path>
                        </svg>
                    </div>
                </div>
            </section>

            <!-- Spotlight Section -->
            <section class="py-20 px-10 w-full h-screen">
                <!-- Slideshow Wrapper Desktop-->
                <div class="flex h-full w-full gap-6">
                    <!-- Left Side -->
                    <div class="flex-1 w-[1px] flex flex-col gap-10">
                        <!-- Heading -->
                        <div class="flex justify-between gap-4 items-center">
                            <h2
                                class="text-2xl md:text-5xl text-UtOrange font-semibold"
                            >
                                Spotlight
                            </h2>
                            <span
                                class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"
                            ></span>
                        </div>

                        <!-- Slider Content Wrapper -->

                        <div class="flex flex-col justify-between h-full">
                            <!-- Slider Content -->
                            <div class="slider-content flex flex-col gap-8">
                                <h3 class="text-4xl">
                                    Data Link Product Page Redesign
                                </h3>
                                <p class="max-w-[70ch]">
                                    Redesigning Nasdaq’s product pages to
                                    improve clarity, accessibility, and
                                    conversion for financial data products.
                                </p>

                                <a
                                    href="#"
                                    class="proj-btn py-1 px-2 flex gap-1 w-fit"
                                >
                                    <p class="flex-1 uppercase">
                                        view projects
                                    </p>
                                    <svg
                                        class="fill-Charcoal w-4"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 12 11"
                                        ><path
                                            d="M.636 6.228a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm2.016 0a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm1.08 4.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm0-9a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.984 7.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm-.048-3a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.048-3a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .384-.156c.152 0 .28.052.384.156a.522.522 0 0 1 .156.384c0 .152-.052.28-.156.384a.522.522 0 0 1-.384.156.522.522 0 0 1-.384-.156Zm.984 4.5a.522.522 0 0 1-.156-.384c0-.152.052-.28.156-.384a.522.522 0 0 1 .385-.156c.151 0 .28.052.383.156a.522.522 0 0 1 .156.384c0 .1