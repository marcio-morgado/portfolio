---
import LayoutBase from "../layouts/LayoutBase.astro";
import Spotlight from "../components/Spotlight.astro";
import DesignArchive from "../components/DesignArchive.astro";

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

type Project = CollectionEntry<"projects">["data"];
const projectsData: Project[] = (await getCollection("projects"))
    .map(({ data }) => data)
    .sort((a, b) => a.order - b.order);

const spotlightProjs = projectsData.filter((proj) => proj.isFeatured);
const designArchiveProjs = projectsData.filter((proj) => !proj.isFeatured);
---

<LayoutBase pageTitle="Product Designer">
    <!-- Hero Section -->
    <section
        id="hero"
        aria-label="Hero"
        class="relative w-screen h-auto md:h-screen flex flex-col before:content-[''] before:absolute before:inset-0 before:opacity-[0.4] before:bg-[url('/mrco.svg')] before:bg-origin-border before:bg-contain py-[60px] justify-center">
        <div class="relative px-6 sm:px-14 flex flex-col gap-6">
            <h1
                class="text-[3.5rem] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.563rem] leading-tight font-extrabold">
                Hey folks,<br />
                <span class="text-UtOrange">I’m Marcio.</span>
            </h1>

            <div class="flex flex-col gap-[100px] sm:flex-row sm:justify-between">
                <p class="sm:max-w-1/2 lg:max-w-[50ch]">
                    I’m a designer who’s done it all — from shaping visual identities to solving complex product
                    challenges. Thirteen years, three roles, one goal: create experiences people enjoy using.
                </p>

