---
// @ts-nocheck
// Utility
import Picture from "astro/components/Picture.astro";

// Components
import Tracker from "../components/Tracker.astro";
import SectionHeading from "../components/SectionHeading.astro";
import socialLinks from "../data/socialLinks.json";

import "../styles/global.css";

// DATA
import { getEntry } from "astro:content";
import { getCollection } from "astro:content";

const slug = "data-link-product-page-redesign/index";

const { data: project } = (await getEntry("projects", slug)) || {};

const projects = await getCollection("projects");

const index = projects.findIndex((p) => p.slug === slug);

const [prev, next] = [
    projects[(index - 1 + projects.length) % projects.length].data.slug,
    projects[(index + 1) % projects.length].data.slug,
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Marcio Morgado • {project?.title}</title>

        <Tracker />
    </head>
    <body class="bg-FloralWhite text-Charcoal">
        <!-- Back to projects button -->
        <a
            href="/projects"
            class="flex items-center w-8 h-8 p-1 fixed inset-2 z-10 rounded-md bg-LightOrange lg:p-2 lg:w-10 lg:h-10 lg:inset-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="fill-Gummetal w-8 h-8" viewBox="0 0 22 20">
                <path
                    d="M2.304 8.928c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408A1.355 1.355 0 0 1 0 9.864c0-.368.128-.68.384-.936.272-.272.592-.408.96-.408s.688.136.96.408Zm2.256 3.768c0 .384-.136.712-.408.984a1.274 1.274 0 0 1-.936.384 1.355 1.355 0 0 1-1.368-1.368c0-.368.136-.68.408-.936.272-.272.592-.408.96-.408s.68.136.936.408c.272.256.408.568.408.936Zm-.408-6.624c.272.272.408.592.408.96s-.136.688-.408.96a1.237 1.237 0 0 1-.936.408c-.368 0-.688-.136-.96-.408a1.314 1.314 0 0 1-.408-.96c0-.368.136-.688.408-.96.272-.272.592-.408.96-.408s.68.136.936.408Zm2.28 9.48c0 .368-.136.68-.408.936a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.274 1.274 0 0 1-.384-.936c0-.384.128-.704.384-.96.272-.272.592-.408.96-.408s.688.136.96.408c.272.256.408.576.408.96ZM6.12 8.928c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.314 1.314 0 0 1-.408-.96c0-.368.136-.68.408-.936.272-.272.592-.408.96-.408s.688.136.96.408ZM6.024 3.24c.272.272.408.592.408.96s-.136.688-.408.96a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.355 1.355 0 0 1-.384-.96c0-.368.128-.688.384-.96.272-.272.592-.408.96-.408s.688.136.96.408ZM8.28 18.384c0 .368-.136.68-.408.936a1.237 1.237 0 0 1-.936.408c-.368 0-.688-.136-.96-.408a1.237 1.237 0 0 1-.408-.936 1.355 1.355 0 0 1 1.368-1.368c.368 0 .68.128.936.384.272.272.408.6.408.984ZM7.872.408c.272.272.408.592.408.96s-.136.688-.408.96a1.237 1.237 0 0 1-.936.408c-.368 0-.688-.136-.96-.408a1.314 1.314 0 0 1-.408-.96c0-.368.136-.688.408-.96.272-.272.592-.408.96-.408s.68.136.936.408Zm2.064 8.52c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.314 1.314 0 0 1-.408-.96c0-.368.136-.68.408-.936.272-.272.592-.408.96-.408s.688.136.96.408Zm3.792 0c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.237 1.237 0 0 1-.936.408 1.355 1.355 0 0 1-1.368-1.368c0-.368.128-.68.384-.936.272-.272.6-.408.984-.408.368 0 .68.136.936.408Zm3.816 0c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.264 1.264 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.355 1.355 0 0 1-.384-.96c0-.368.128-.68.384-.936.272-.272.592-.408.96-.408.384 0 .704.136.96.408Zm3.816 0c.272.256.408.568.408.936 0 .368-.136.688-.408.96a1.314 1.314 0 0 1-.96.408c-.368 0-.688-.136-.96-.408a1.314 1.314 0 0 1-.408-.96c0-.368.136-.68.408-.936.272-.272.592-.408.96-.408s.688.136.96.408Z"
                ></path>
            </svg>
        </a>

        <main>
            <!-- Hero Section -->
            <div class="bg-Charcoal relative">
                <!-- Hero Image -->
                <div id="hero" class="relative w-full h-[120vh] overflow-hidden max-w-fu">
                    <div class="w-full h-full">
                        <Picture
                            id="heroImg"
                            src={project?.hero.cover}
                            alt={"Designed Product Page"}
                            class="object-cover absolute inset-0 align-middle h-full scale-[1.1]"
                        />
                    </div>
                </div>

                <!-- Project Card Wrapper -->
                <div
                    id="projCard--wrap"
                    class="flex flex-col justify-end w-screen max-w-full h-full items-end fixed inset-0 z-10 p-2 pointer-events-none">
                    <!-- Project Card Inner wrapper -->
                    <div
                        id="projCard--inner-wrap"
                        class="flex flex-col items-center md:flex-row md:h-full pointer-events-auto">
                        <!-- Pulltab -->
                        <div
                            id="projCard--pulltab"
                            class="flex flex-col md:flex-row items-center justify-center gap-2 bg-Alabaster w-20 h-10 relative md:w-8 md:h-20 translate-x-0.5 opacity-0">
                            <span class="line w-8 h-0.5 md:w-0.5 md:h-8 bg-Gummetal"></span>
                            <span class="line w-8 h-0.5 md:w-0.5 md:h-8 bg-Gummetal"></span>
                        </div>

                        <!-- Project Card -->
                        <div
                            id="projCard"
                            class="flex flex-col gap-8 self-end justify-between p-8 rounded-lg md:w-[25rem] md:h-full bg-Alabaster">
                            <!-- Project Card content -->
                            <div id="projCard--content" class="flex flex-col gap-8">
                                <div>
                                    <h1 class="font-light leading-tight text-2xl md:text-3xl mb-7 text-Gummetal">
                                        {project?.hero.title}
                                    </h1>

                                    <ul class="text-xs lg:text-sm text-SlateGray">
                                        {project?.hero.metadata.map((item) => <li class="mb-1">{item}</li>)}
                                    </ul>
                                </div>

                                <!-- Horizontal Line -->
                                <div class="h-[1px] w-ful bg-Charcoal"></div>

                                <p class="text-sm lg:text-base text-Gummetal">
                                    {project?.hero.description}
                                </p>
                            </div>

                            <!-- Project Card Prev/Next Nav -->
                            <div id="projCard--nav" class="w-full pt-4 flex gap-4 items-center projectNav">
                                <a class="fill-SlateGray hover:fill-UtOrange" href={prev}>
                                    <svg class="w-8 h-8"><use href="arrows.svg#lfArrow"></use></svg>
                                </a>
                                <span class="fill-Charcoal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="29" viewBox="0 0 10 29"
                                        ><path d="m8.024.116 1.28.352L1.88 28.884.6 28.532 8.024.116Z"></path>
                                    </svg>
                                </span>

                                <a class="fill-Charcoal hover:fill-UtOrange" href={next}
                                    ><svg class="w-8 h-8"><use href="arrows.svg#rtArrow"></use></svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {
                project?.sections.map((section) => (
                    <section
                        class=" relative px-2 py-8 xl:px-10 xl:py-20 2xl:px-48 2xl:py-24"
                        data-analytics-section={section.sectionId.toLowerCase().replaceAll(" ", "-")}>
                        {section.heading && (
                            <>
                                <div class="flex justify-between gap-4 items-center mb-6">
                                    <h2 class="text-2xl text-UtOrange font-semibold leading-snug xl:text-[2.5rem] xl:leading-12">
                                        <span>{section.heading.bold}</span>

                                        <br />
                                        <span class="font-light">{section.heading.light}</span>
                                    </h2>
                                    <span class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]" />
                                </div>
                            </>
                        )}

                        <div class="flex flex-col gap-8">
                            {section.text && <p class="max-w-xl self-end">{section.text}</p>}

                            {/* Rendering logic by sectionType */}

                            {section.sectionType === "singleImage" && (
                                <figure class="text-SlateGray">
                                    <figcaption class="font-mono font-medium text-ResedaGreen text-sm border-l-4 border-l-MossGreen pl-2 mb-4">
                                        {section.visual.caption}
                                    </figcaption>
                                    <Picture src={section.visual.src} alt={section.visual.alt} />
                                </figure>
                            )}

                            {section.sectionType === "gallery" && (
                                <>
                                    {/* Swipper container */}
                                    <div class="md:hidden">
                                        <div class="swiper gallery">
                                            {/* Swiper Wrapper */}
                                            <p class="font-mono font-medium text-ResedaGreen text-sm border-l-4 border-l-MossGreen pl-2 mb-4">
                                                {section.visual.caption}
                                            </p>

                                            <div class="swiper-wrapper">
                                                {section.visual.images.map((img) => (
                                                    <div class="swiper-slide">
                                                        <Picture src={img.src} alt={img.alt} inferSize={true} />
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <p class="font-mono font-medium text-ResedaGreen text-sm border-l-4 border-l-MossGreen pl-2 mb-4">
                                            {section.visual.caption}
                                        </p>

                                        <div
                                            class={` hidden ${
                                                section.visual.images.length === 2
                                                    ? "md:grid md:grid-cols-2 md:gap-4"
                                                    : "md:grid md:grid-cols-3 md:gap-4"
                                            }`}>
                                            {section.visual.images.map((img) => (
                                                <div>
                                                    <Picture src={img.src} alt={img.alt} inferSize={true} />
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </>
                            )}

                            {section.sectionType === "beforeAfter" && (
                                <div>
                                    <p class="font-mono font-medium text-ResedaGreen text-sm border-l-4 border-l-MossGreen pl-2 mb-4">
                                        {section.visual.caption}
                                    </p>
                                    <img-comparison-slider class="comparisonSlider" hover="hover">
                                        <div slot="first">
                                            <Picture src={section.visual.before.src} alt={section.visual.before.alt} />
                                        </div>

                                        <div slot="second">
                                            <Picture src={section.visual.after.src} alt={section.visual.after.alt} />
                                        </div>

                                        <svg
                                            slot="handle"
                                            class="w-8 md:w-12"
                                            viewBox="0 0 16 16"
                                            fill="none"
                                            xmlns="http://www.w3.org/2000/svg">
                                            <rect width="16" height="16" rx="8" fill="#E6EBE0" />
                                            <line
                                                x1="6.53635"
                                                y1="3.31738"
                                                x2="6.53635"
                                                y2="12.6832"
                                                stroke="#6F7F59"
                                                stroke-width="1.56098"
                                            />
                                            <line
                                                x1="9.65842"
                                                y1="3.31738"
                                                x2="9.65842"
                                                y2="12.6832"
                                                stroke="#8A9A5B"
                                                stroke-width="1.56098"
                                            />
                                        </svg>
                                    </img-comparison-slider>
                                </div>
                            )}
                        </div>
                    </section>
                ))
            }
            <section></section>
        </main>

        <!-- Footer -->
        <footer class="px-6 sm:px-14 py-20">
            <div class="flex justify-between gap-4 items-center mb-14">
                <h2 class="text-2xl text-UtOrange font-semibold">
                    <span>Let’s Collaborate</span>

                    <br />
                    <span class="font-light"><a href="mailto:hello@mrco.design">hello@mrco.design</a></span>
                </h2>
                <span class="h-0.5 bg-Timberwolf w-full flex-[1] self-end translate-y-[-1em]"></span>
            </div>

            <div class="flex flex-col-reverse md:flex-row md:justify-between gap-2 md:gap-0">
                <p class="uppercase font-extralight text-base">
                    Site Content © {currentYear} Marcio Morgado <br />All rights Reserved
                </p>
                <p>Crafted with love, forged in frustration.</p>
                <ul class="inline-flex gap-8">
                    {
                        socialLinks.map((link) => (
                            <li>
                                <a href={link.url} target="_blank" rel="noopener noreferrer">
                                    {link.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </footer>

        <script>
            // @ts-nocheck
            import "img-comparison-slider";

            import Swiper from "swiper";
            import "swiper/css";

            new Swiper(".gallery", {
                spaceBetween: 16,
            });

            import gsap from "gsap";
            import { ScrollTrigger } from "gsap/all";
            gsap.registerPlugin(ScrollTrigger);

            document.addEventListener("DOMContentLoaded", () => {
                const ctx = gsap.context(() => {
                    const heroImg = document.getElementById("heroImg");

                    const pullTab = document.getElementById("projCard--pulltab");

                    const projCardInner = document.getElementById("projCard--inner-wrap");

                    let isHidden = true;

                    gsap.set(pullTab, { pointerEvents: "none" });

                    const matchMedia = gsap.matchMedia();

                    matchMedia.add(
                        {
                            isDesktop: "(min-width: 768px)",
                            isMobile: "(max-width: 767px)",
                        },
                        (context) => {
                            const { isDesktop } = context.conditions;

                            const heroImgTl = gsap.timeline({
                                scrollTrigger: {
                                    trigger: "#hero",
                                    start: "top+=1 top",
                                    end: "+=225",
                                    scrub: true,
                                },
                            });

                            const projCardTl = gsap.timeline({
                                scrollTrigger: {
                                    trigger: document.body,
                                    start: "top+=50 top",
                                    scrub: false,
                                    toggleActions: "play reverse play reverse",
                                    onEnter: () => {
                                        gsap.set(pullTab, { pointerEvents: "auto" });

                                        setupInteractions(isDesktop);
                                    },
                                },
                            });

                            heroImgTl.to(heroImg, {
                                scale: 1,
                            });

                            projCardTl.to(pullTab, {
                                opacity: 1,
                                duration: 0.3,
                                ease: "power3.inOut",
                            });

                            if (isDesktop) {
                                const offset = projCardInner?.offsetWidth - pullTab?.offsetWidth;

                                projCardTl.to(
                                    projCardInner,
                                    {
                                        x: offset,
                                        duration: 0.5,
                                        ease: "power2.inOut",
                                    },
                                    "-=0.3"
                                );
                            } else {
                                const offset = projCardInner?.offsetHeight - pullTab?.offsetHeight;

                                projCardTl.to(projCardInner, {
                                    y: offset,
                                    duration: 0.5,
                                    ease: "power2.inOut",
                                });
                            }
                        }
                    );

                    function setupInteractions(isDesktop) {
                        if (isDesktop) {
                            pullTab?.addEventListener("mouseenter", () => {
                                if (isHidden) {
                                    gsap.to(projCardInner, {
                                        x: 0,
                                        duration: 0.5,
                                        ease: "power2.in",
                                    });

                                    isHidden = false;
                                }
                            });

                            projCardInner?.addEventListener("mouseleave", () => {
                                if (!isHidden) {
                                    const offset = projCardInner.offsetWidth - pullTab?.offsetWidth;

                                    gsap.to(projCardInner, {
                                        x: offset,
                                        duration: 0.4,
                                        ease: "power2.in",
                                    });

                                    isHidden = true;
                                }
                            });
                        } else {
                            pullTab?.addEventListener("click", () => {
                                const offset = projCardInner?.offsetHeight - pullTab.offsetHeight;

                                gsap.to(projCardInner, {
                                    y: isHidden ? 0 : offset,
                                    duration: 0.4,
                                    ease: "power2.inOut",
                                });

                                isHidden = !isHidden;
                            });
                        }
                    }
                });

                return () => ctx.revert();
            });
        </script>

        <style>
            .comparisonSlider {
                --divider-width: 4px;
                --divider-color: var(--color-MossGreen);
            }

            .comparisonSlider:focus {
                outline: 1px solid var(--color-Timberwolf);
            }
        </style>
    </body>
</html>
