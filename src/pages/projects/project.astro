---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHero from "../../components/ProjectHero.astro";
import ProjectSection from "../../components/ProjectSection.astro";

import { loadImages } from "../../util/loadImages";

interface Project {
    title: string;
    id: string;
    published: string;
}

// Data
const projectModules = import.meta.glob("../../data/projects/**/*.json", {
    eager: true,
});

const project = Object.values(projectModules)[0].default;

// Import all images
const imageModules = import.meta.glob(
    "../../data/projects/**/*.{jpg,jpeg,gif,png}"
);
const imageMap = await loadImages(imageModules);
---

<BaseLayout title={project.title} />
