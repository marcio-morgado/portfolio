---
// Utility
import Image from "astro/components/Image.astro";
import Picture from "astro/components/Picture.astro";
import { loadImages } from "../../util/loadImages";

// Page Components
import BaseLayout from "../../layouts/BaseLayout.astro";
import ImgComparison from "../../components/ImgComparison.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import DesignArchive from "../../components/DesignArchive.astro";

import ProductResearchSVG from "../../assets/projects/dl-product-page/assets/dl-product-research.svg";
import ProjectHero from "../../components/ProjectHero.astro";
---

<BaseLayout title="Nasdaq Data Link Product Page Redesign">
    <ProjectHero />
    <section class="px-2 py-8"></section>
    <section class="px-2 py-8">
        <SectionHeading boldText="Understanding" restText="the Problem" />
        <div class="flex flex-col gap-12">
            <p>
                The original product page was fragmented and hard to navigate.
                Key information like pricing and documentation was buried across
                tabs, leading to user frustration, low conversion rates and an
                increase in support tickets.
            </p>

            <div class="flex flex-col gap-4">
                <div class="p-6 border-2 border-Charcoal rounded-lg">
                    <div>
                        <ProductResearchSVG />
                    </div>
                </div>
            </div>

            <section class="px-2 py-8">
                <SectionHeading
                    boldText="Exploring"
                    restText="Design Directions"
                />
                <div>
                    <p>
                        I audited the existing experience, analyzed support
                        tickets and mapped the user journey to surface friction
                        points. Interviews with users and internal teams
                        revealed blockers around pricing clarity, content
                        visibility and trust. These insights shaped early
                        concepts and aligned stakeholders around key priorities.
                    </p>

                    <div>
                        <figure>
                            <figcaption>
                                Some sketches I created during my exploration
                                phase
                            </figcaption>

                            <div class="swiper sketches">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <img src="#" alt="Placeholder" />
                                    </div>
                                    <div class="swiper-slide">
                                        <img src="#" alt="Placeholder" />
                                    </div>
                                    <div class="swiper-slide">
                                        <img src="#" alt="Placeholder" />
                                    </div>
                                </div>
                            </div>
                        </figure>
                    </div>
                    <figure>
                        <figcaption>
                            <strong>Wireframes</strong> that helped everyone stay
                            on the same page
                        </figcaption>

                        <img src="#" alt="Placeholder" />
                        <img src="#" alt="Placeholder" />
                    </figure>
                </div>
            </section>

            <section class="px-2 py-8">
                <SectionHeading boldText="Crafting" restText="the Solution" />
                <div>
                    <p>
                        I audited the existing experience, analyzed support
                        tickets and mapped the user journey to surface friction
                        points. Interviews with users and internal teams
                        revealed blockers around pricing clarity, content
                        visibility and trust. These insights shaped early
                        concepts and aligned stakeholders around key priorities.
                    </p>
                    <figure>
                        <figcaption>Before & After</figcaption>
                        <ImgComparison firstImgURL="#" secondImgURL="#" />
                    </figure>
                </div>
            </section>
        </div>

        <script>
            import Swiper from "swiper";
            import "swiper/css";

            new Swiper(".sketches", {});

            import gsap from "gsap";
            import { GSDevTools } from "gsap/GSDevTools";
            gsap.registerPlugin(GSDevTools);

            const tl = gsap.timeline();

            // tl.to(".projectCard", { xPercent: 200 });

            GSDevTools.create({ animation: tl });
        </script>

        <style></style>
    </section>
</BaseLayout>
